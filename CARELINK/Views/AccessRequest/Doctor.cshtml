
@model DoctorAccessViewModel

@{
    ViewData["Title"] = "Find Patient";
}

<div class="container mt-4">

    <h1 class="h3 mb-1">Dr. @Model.Doctor.FullName</h1>
    <p class="text-muted">@Model.Doctor.Specialty · Verified ✓</p>

    @if (TempData["Message"] is not null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }

    @if (TempData["Error"] is not null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card mb-4">
        <div class="card-body">

            <h2 class="h5">Search Patient by Patient ID</h2>

            <form asp-action="Doctor" method="get" class="d-flex gap-2">

                <input type="text"
                       name="patientId"
                       value="@Model.SearchPatientId"
                       class="form-control"
                       placeholder="PT-000001" />

                <button type="submit" class="btn btn-primary">
                    Search
                </button>

            </form>

            @if (Model.SearchedButNotFound)
            {
                <div class="alert alert-warning mt-3 mb-0">
                    No patient found with this Patient ID.
                </div>
            }

            @if (Model.Found is { } p)
            {
                <div class="d-flex justify-content-between align-items-center border rounded p-3 mt-3">

                    <div>
                        <strong>@p.DisplayName</strong>

                        @(p.Age is int age ? $" · {age} years" : "")

                        <br />

                        <small class="text-muted">
                            Patient ID: @p.PatientId · National ID hidden
                        </small>
                    </div>

                    <form asp-action="Create" method="post">

                        <input type="hidden"
                               name="patientId"
                               value="@p.PatientId" />

                        <button type="submit" class="btn btn-success">
                            Request Access
                        </button>

                    </form>

                </div>
            }

        </div>
    </div>

    <h2 class="h5">My Access Requests</h2>

    @if (Model.Requests.Count == 0)
    {
        <p class="text-muted">No requests yet.</p>
    }
    else
    {
        <div class="table-responsive">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Request</th>
                        <th>Patient</th>
                        <th>Sent</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model.Requests)
                    {
                        <tr>
                            <td>@r.RequestId</td>

                            <td>@r.PatientId</td>

                            <td>@r.CreatedAt.ToLocalTime().ToString("g")</td>

                            <td>
                                <partial name="_AccessStatus" model="r" />
                            </td>

                            <td>
                                @if (r.WaitingForCode)
                                {
                                    <a asp-action="EnterCode"
                                       asp-route-id="@r.RequestId"
                                       class="btn btn-sm btn-primary">
                                        Enter Code
                                    </a>
                                }
                                else if (r.Status == AccessRequestStatus.Pending)
                                {
                                    <span class="text-muted small">
                                        Waiting for patient
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>
