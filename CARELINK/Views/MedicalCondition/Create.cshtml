
@model CARELINK.ViewModels.MedicalConditionFormViewModel

@{
    ViewData["Title"] = "Add Medical Condition";
}

<div class="container my-4">

    <h2 class="mb-4">Add Medical Condition</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="ConditionName"
                           class="form-label">
                        Condition Name
                    </label>

                    <input asp-for="ConditionName"
                           class="form-control"
                           placeholder="Enter condition name" />

                    <span asp-validation-for="ConditionName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="DiagnosisDate"
                           class="form-label">
                        Diagnosis Date
                    </label>

                    <input asp-for="DiagnosisDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="DiagnosisDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes"
                           class="form-label">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="4"
                              placeholder="Additional notes (optional)">
                    </textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Condition
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
