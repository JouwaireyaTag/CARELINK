
@model List<CARELINK.Models.AuditLog>

@{
    ViewData["Title"] = "Audit Logs";
}

<div class="container mt-4">

    <h2 class="mb-3">Audit Logs</h2>

    <p class="text-muted">
        Showing the latest @Model.Count audit records.
    </p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No audit logs found.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped align-middle">

                <thead>
                    <tr>
                        <th>Audit ID</th>
                        <th>User</th>
                        <th>Action</th>
                        <th>Date and Time (Local)</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td>@log.AuditId</td>

                            <td>
                                @(log.User?.UserName ?? log.UserId ?? "System")
                            </td>

                            <td>@log.Action</td>

                            <td>
                                @log.LoggedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>
