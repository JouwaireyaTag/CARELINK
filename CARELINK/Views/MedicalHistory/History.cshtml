
@model CARELINK.ViewModels.MedicalHistoryViewModel

@{
    ViewData["Title"] = "Medical History";
}

<div class="container my-4">
    @if (Model.IsDoctorView)
    {
        <div class="alert alert-success">
            Access granted by patient · ends at
            @Model.AccessUntilUtc!.Value.ToLocalTime().ToString("HH:mm")
            · every view is saved in the Audit Log
        </div>
    }

    <h2>@Model.DisplayName</h2>

    <p class="text-muted">
        Patient ID: @Model.PatientId
        @if (Model.Age is not null)
        {
            <text> · @Model.Age years</text>
        }
    </p>

    @* Patient management links *@
    @if (!Model.IsDoctorView)
    {
        <div class="d-flex flex-wrap gap-2 my-3">
            <a asp-controller="MedicalCondition"
               asp-action="Index"
               class="btn btn-outline-primary">
                Manage Conditions
            </a>

            <a asp-controller="Allergy"
               asp-action="Index"
               class="btn btn-outline-primary">
                Manage Allergies
            </a>

            <a asp-controller="Surgery"
               asp-action="Index"
               class="btn btn-outline-primary">
                Manage Surgeries
            </a>

            <a asp-controller="Medication"
               asp-action="Index"
               class="btn btn-outline-primary">
                Manage Medications
            </a>

            <a asp-controller="MedicalVisit"
               asp-action="Mine"
               class="btn btn-outline-primary">
                My Visits
            </a>
        </div>
    }
    else
    {
        @* Doctor can add a visit only with active access *@
        <div class="my-3">
            <a asp-controller="MedicalVisit"
               asp-action="Create"
               asp-route-patientId="@Model.PatientId"
               class="btn btn-primary">
                Add Medical Visit
            </a>
        </div>
    }

    <h4 class="mt-4">Conditions</h4>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Condition</th>
                <th>Since</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Conditions)
            {
                <tr>
                    <td>@c.ConditionName</td>
                    <td>@c.DiagnosisDate?.ToString("yyyy-MM-dd")</td>
                    <td>@c.Notes</td>
                </tr>
            }

            @if (!Model.Conditions.Any())
            {
                <tr>
                    <td colspan="3" class="text-muted">None recorded.</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Allergies</h4>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Allergy</th>
                <th>Reaction</th>
                <th>Severity</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model.Allergies)
            {
                <tr>
                    <td>@a.AllergyName</td>
                    <td>@a.Reaction</td>
                    <td>@a.Severity</td>
                    <td>@a.Notes</td>
                </tr>
            }

            @if (!Model.Allergies.Any())
            {
                <tr>
                    <td colspan="4" class="text-muted">None recorded.</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Surgeries</h4>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Surgery</th>
                <th>Date</th>
                <th>Hospital</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var s in Model.Surgeries)
            {
                <tr>
                    <td>@s.SurgeryName</td>
                    <td>@s.SurgeryDate?.ToString("yyyy-MM-dd")</td>
                    <td>@s.Hospital</td>
                    <td>@s.Notes</td>
                </tr>
            }

            @if (!Model.Surgeries.Any())
            {
                <tr>
                    <td colspan="4" class="text-muted">None recorded.</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Medications</h4>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Medication</th>
                <th>Dosage</th>
                <th>Frequency</th>
                <th>Start</th>
                <th>End</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model.Medications)
            {
                <tr>
                    <td>@m.MedicationName</td>
                    <td>@m.Dosage</td>
                    <td>@m.Frequency</td>
                    <td>@m.StartDate?.ToString("yyyy-MM-dd")</td>
                    <td>@m.EndDate?.ToString("yyyy-MM-dd")</td>
                    <td>@m.Notes</td>
                </tr>
            }

            @if (!Model.Medications.Any())
            {
                <tr>
                    <td colspan="6" class="text-muted">None recorded.</td>
                </tr>
            }
        </tbody>
    </table>

    <h4 class="mt-4">Visits</h4>

    <table class="table table-sm">
        <thead>
            <tr>
                <th>Date</th>
                <th>Doctor</th>
                <th>Diagnosis</th>
                <th>Treatment</th>
                <th>Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var v in Model.Visits)
            {
                <tr>
                    <td>
                        @v.VisitDate?.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                    </td>
                    <td>@v.Doctor?.FullName</td>
                    <td>@v.Diagnosis</td>
                    <td>@v.Treatment</td>
                    <td>@v.Notes</td>
                </tr>
            }

            @if (!Model.Visits.Any())
            {
                <tr>
                    <td colspan="5" class="text-muted">None recorded.</td>
                </tr>
            }
        </tbody>
    </table>
</div>
