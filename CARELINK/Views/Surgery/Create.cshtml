
@model CARELINK.ViewModels.SurgeryFormViewModel

@{
    ViewData["Title"] = "Add Surgery";
}

<div class="container my-4">

    <h2 class="mb-4">Add Surgery</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">
                    <label asp-for="SurgeryName" class="form-label">
                        Surgery Name
                    </label>

                    <input asp-for="SurgeryName"
                           class="form-control"
                           placeholder="Enter surgery name" />

                    <span asp-validation-for="SurgeryName"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="SurgeryDate" class="form-label">
                        Surgery Date
                    </label>

                    <input asp-for="SurgeryDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="SurgeryDate"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Hospital" class="form-label">
                        Hospital
                    </label>

                    <input asp-for="Hospital"
                           class="form-control"
                           placeholder="Enter hospital name" />

                    <span asp-validation-for="Hospital"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">
                        Notes
                    </label>

                    <textarea asp-for="Notes"
                              class="form-control"
                              rows="4"
                              placeholder="Additional notes (optional)">
                    </textarea>

                    <span asp-validation-for="Notes"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Save Surgery
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
